{
  "manifest_version": 3,
  "name": "CloudDock Bridge",
  "description": "Open explicitly allowed HTTPS pages in CloudDock.",
  "version": "1.0.0",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "在 CloudDock 中打开",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
